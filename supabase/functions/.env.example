# Required for both modes. Leave JUDGE0_AUTH_MODE empty only to use the
# backwards-compatible judge0 default.
JUDGE0_AUTH_MODE=
JUDGE0_BASE_URL=

# Native/self-hosted Judge0 (JUDGE0_AUTH_MODE=judge0)
JUDGE0_AUTH_TOKEN=

# RapidAPI (JUDGE0_AUTH_MODE=rapidapi)
JUDGE0_RAPIDAPI_KEY=
JUDGE0_RAPIDAPI_HOST=

# Optional Judge0 language-id overrides
JUDGE0_PYTHON_LANGUAGE_ID=
JUDGE0_JAVASCRIPT_LANGUAGE_ID=
